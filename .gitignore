# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*


# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files (build/ is ignored wholesale above; this project's
# top-level Makefile is hand-written and intentionally tracked)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# m8's per-workspace config, sessions and vector-database memory. Skills are
# meant to be shared, so they are tracked (ignore .m8/'s contents, not the dir
# itself, so the negation below can take effect).
.m8/*
!.m8/skills/
# The Parallel Search API key for the `websearch` tool. Covered by .m8/* above;
# spelled out here so it is obvious this is a secret and never committed.
.m8/parallel_api_key
